{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Django",
      "type": "shell",
      "command": "uv",
      "args": ["run", "python", "manage.py", "runserver"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "VITE_PORT": "3173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false,
        "group": "dev-servers"
      },
      "problemMatcher": [],
      "isBackground": true,
      "icon": { "id": "server", "color": "terminal.ansiGreen" }
    },
    {
      "label": "Start Vite",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {
          "PORT": "3173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false,
        "group": "dev-servers"
      },
      "problemMatcher": [],
      "isBackground": true,
      "icon": { "id": "zap", "color": "terminal.ansiYellow" }
    },
    {
      "label": "Start All",
      "dependsOn": ["Start Django", "Start Vite"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "icon": { "id": "rocket", "color": "terminal.ansiBlue" }
    },
    {
      "label": "migrate",
      "type": "shell",
      "command": "uv",
      "args": ["run", "python", "manage.py", "migrate"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "pytest (unit)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "pytest", "-m", "not e2e"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "e2e: setup + test",
      "type": "shell",
      "command": "bash e2e/setup-db.sh && cd e2e && npm test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "lint (prek)",
      "type": "shell",
      "command": "prek",
      "args": ["run", "--all-files"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "typecheck (mypy)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "mypy", "dream_blog"],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
