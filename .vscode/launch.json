{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "--noreload", "127.0.0.1:8000"],
      "django": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Django: manage.py with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "console": "integratedTerminal",
      "args": "${command:pickArgs}",
      "django": true,
      "justMyCode": false
    },
    {
      "name": "pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "--no-header", "--reuse-db"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "DJANGO_SETTINGS_MODULE": "config.settings.test" }
    }
  ]
}
