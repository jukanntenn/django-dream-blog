[program:django-dream-blog]
directory={{ project_path }}
command={{ project_venv_path }}/bin/gunicorn config.asgi:application -k uvicorn.workers.UvicornWorker -w 2 -b 127.0.0.1:{{ port }}
autostart=true
startsecs=1
startretries=3
autorestart=unexpected
stopasgroup=true
killasgroup=true
user={{ user }}
environment=DJANGO_READ_DOT_ENV_FILE="yes"
stdout_logfile={{ project_logs_path }}/django-dream-blog.out.log
stderr_logfile={{ project_logs_path }}/django-dream-blog.err.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=10
stderr_logfile_maxbytes=50MB
stderr_logfile_backups=10
