[program:django-dream-blog-huey]
directory={{ project_path }}
command={{ project_venv_path }}/bin/python manage.py run_huey --settings=config.settings.production
autostart=true
startsecs=1
startretries=3
autorestart=unexpected
stopasgroup=true
killasgroup=true
user={{ user }}
environment=DJANGO_READ_DOT_ENV_FILE="yes"
stdout_logfile={{ project_logs_path }}/django-dream-blog-huey.out.log
stderr_logfile={{ project_logs_path }}/django-dream-blog-huey.err.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=10
stderr_logfile_maxbytes=50MB
stderr_logfile_backups=10
